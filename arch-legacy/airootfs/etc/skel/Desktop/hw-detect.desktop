[Desktop Entry]
Version=1.0
Type=Application
Name=Diagnóstico de Hardware
GenericName=Detector de Hardware
Comment=Analiza y detecta tu GPU, batería de laptop, audio y compatibilidad Mac
Exec=xfce4-terminal -e "hw-detect; read -p 'Presiona Enter para cerrar...'"
Icon=preferences-system
Terminal=false
Categories=System;
StartupNotify=true
