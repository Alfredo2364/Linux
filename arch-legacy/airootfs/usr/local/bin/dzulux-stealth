#!/usr/bin/env bash
# ==============================================================================
# dzulux-stealth - Escudo de Privacidad y Redes Públicas
# Dzulux Linux - Diseñado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

if command -v dialog >/dev/null 2>&1; then
    UI="dialog"
elif command -v whiptail >/dev/null 2>&1; then
    UI="whiptail"
else
    UI=""
fi

WIFI_INT="$(ip -o link show | awk -F': ' '{print $2}' | grep -E '^wl' | head -n1 || echo "")"

main_menu() {
    if [ -n "$UI" ]; then
        CHOICE=$($UI --title "Dzulux Stealth - Modo Privacidad (Alfredo Dzul)" --menu \
"Protege tu navegación en cafeterías, escuelas y aeropuertos:" 16 70 4 \
"1" "🛡️ Activar Escudo Stealth (MAC Aleatoria + DNS Seguro + Firewall)" \
"2" "🔓 Desactivar Escudo (Restaurar Conexión Estándar)" \
"3" "🔍 Comprobar Estado de Privacidad y Dirección MAC" \
"4" "Salir" 3>&1 1>&2 2>&3)
    else
        clear
        echo -e "${CYAN}${BOLD}=== DZULUX STEALTH - ESCUDO DE PRIVACIDAD ===${NC}"
        echo -e "Diseñado por Alfredo Dzul\n"
        echo "1) Activar Escudo Stealth"
        echo "2) Desactivar Escudo"
        echo "3) Comprobar Estado de Privacidad"
        echo "4) Salir"
        read -p "Elige una opción (1-4): " CHOICE
    fi

    case "$CHOICE" in
        1) enable_stealth ;;
        2) disable_stealth ;;
        3) check_status ;;
        *) exit 0 ;;
    esac
}

enable_stealth() {
    clear
    echo -e "${GREEN}${BOLD}Activando Escudo de Privacidad Dzulux...${NC}"

    # 1. Dirección MAC aleatoria si hay Wi-Fi
    if [ -n "$WIFI_INT" ]; then
        echo -e "  * Generando dirección MAC aleatoria para ${WIFI_INT}..."
        RANDOM_MAC="$(printf '02:%02x:%02x:%02x:%02x:%02x\n' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))"
        sudo ip link set dev "$WIFI_INT" down 2>/dev/null || true
        sudo ip link set dev "$WIFI_INT" address "$RANDOM_MAC" 2>/dev/null || true
        sudo ip link set dev "$WIFI_INT" up 2>/dev/null || true
        echo -e "  * ${GREEN}✓ Nueva dirección MAC anónima asignada: ${RANDOM_MAC}${NC}"
    fi

    # 2. DNS Seguro Anti-rastreo y Anti-malware (Quad9 & Cloudflare)
    echo -e "  * Configurando servidores DNS seguros con bloqueo de malware..."
    echo -e "nameserver 9.9.9.9\nnameserver 1.1.1.1" | sudo tee /etc/resolv.conf >/dev/null
    echo -e "  * ${GREEN}✓ DNS Cifrado Anti-malware activado (Quad9 / Cloudflare).${NC}"

    # 3. Cortafuegos UFW estricto (bloquea escaneo de puertos en Wi-Fi público)
    if command -v ufw >/dev/null 2>&1; then
        sudo ufw default deny incoming >/dev/null 2>&1 || true
        sudo ufw default allow outgoing >/dev/null 2>&1 || true
        sudo ufw --force enable >/dev/null 2>&1 || true
        echo -e "  * ${GREEN}✓ Cortafuegos UFW blindado contra rastreo en red local.${NC}"
    fi

    echo -e "\n${GREEN}${BOLD}¡Escudo Stealth Activado! Tu equipo ahora es invisible en redes públicas.${NC}"
    read -p "Presiona ENTER para volver..." _
    main_menu
}

disable_stealth() {
    clear
    echo -e "${CYAN}Restaurando configuración de red estándar...${NC}"
    sudo systemctl restart NetworkManager 2>/dev/null || true
    echo -e "${GREEN}✓ Red restablecida a valores por defecto.${NC}"
    read -p "Presiona ENTER para volver..." _
    main_menu
}

check_status() {
    clear
    echo -e "${CYAN}${BOLD}Estado Actual de tu Conexión:${NC}\n"
    if [ -n "$WIFI_INT" ]; then
        echo -e "Interfaz Wi-Fi: ${BOLD}${WIFI_INT}${NC}"
        echo -e "Dirección MAC:  ${GREEN}$(cat "/sys/class/net/${WIFI_INT}/address" 2>/dev/null || echo "N/A")${NC}"
    fi
    echo -e "Servidores DNS: $(grep nameserver /etc/resolv.conf | awk '{print $2}' | tr '\n' ' ')"
    if command -v ufw >/dev/null 2>&1; then
        echo -e "Cortafuegos:    $(sudo ufw status | head -n1)"
    fi
    echo ""
    read -p "Presiona ENTER para volver..." _
    main_menu
}

main_menu
