#!/usr/bin/env bash
# ==============================================================================
# dzulux-backup - Sistema de Respaldo y Restauración de Archivos Personales
# Dzulux Linux 2.0 (Beta) - Diseñado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

if command -v dialog >/dev/null 2>&1; then
    UI="dialog"
elif command -v whiptail >/dev/null 2>&1; then
    UI="whiptail"
else
    UI=""
fi

USER_HOME="${HOME}"
if [ -n "${SUDO_USER:-}" ] && [ -d "/home/${SUDO_USER}" ]; then
    USER_HOME="/home/${SUDO_USER}"
fi

DEFAULT_BACKUP_DIR="${USER_HOME}/Respaldos_Dzulux"
mkdir -p "$DEFAULT_BACKUP_DIR"

main_menu() {
    while true; do
        if [ -n "$UI" ]; then
            CHOICE=$($UI --title "Dzulux Backup 2.0 - Copias de Seguridad (Alfredo Dzul)" --menu \
"Protege tus documentos, fotos y configuraciones personales:" 18 74 5 \
"1" "📦 Crear Respaldo Comprimido (.tar.gz) de tu carpeta personal" \
"2" "🔄 Sincronizar Carpeta Personal a Memoria USB / Disco Externo (rsync)" \
"3" "⏪ Restaurar un Respaldo Anterior (.tar.gz)" \
"4" "📋 Ver Respaldos Guardados" \
"5" "🚪 Salir" 3>&1 1>&2 2>&3 || echo "5")
        else
            clear
            echo -e "${CYAN}${BOLD}=== DZULUX BACKUP 2.0 - COPIAS DE SEGURIDAD ===${NC}"
            echo -e "Diseñado por Alfredo Dzul\n"
            echo "1) Crear Respaldo Comprimido (.tar.gz) de tu carpeta personal"
            echo "2) Sincronizar a Memoria USB / Disco Externo (rsync)"
            echo "3) Restaurar un Respaldo Anterior (.tar.gz)"
            echo "4) Ver Respaldos Guardados"
            echo "5) Salir"
            read -p "Elige una opción [1-5]: " CHOICE
        fi

        case "$CHOICE" in
            1) create_tar_backup ;;
            2) sync_external_backup ;;
            3) restore_tar_backup ;;
            4) list_backups ;;
            *) exit 0 ;;
        esac
    done
}

create_tar_backup() {
    local DEST_DIR="$DEFAULT_BACKUP_DIR"
    if [ -n "$UI" ]; then
        DEST_DIR=$($UI --title "Carpeta de Destino" --inputbox \
"Ingresa la ruta donde deseas guardar el archivo de respaldo (puedes poner la ruta de tu memoria USB o dejar la predeterminada):" 11 72 "$DEFAULT_BACKUP_DIR" 3>&1 1>&2 2>&3 || echo "")
    fi
    [ -z "$DEST_DIR" ] && return
    mkdir -p "$DEST_DIR"

    local FILENAME="Respaldo_Dzulux_$(date +%Y%m%d_%H%M%S).tar.gz"
    local FULL_PATH="${DEST_DIR}/${FILENAME}"

    clear
    echo -e "${CYAN}${BOLD}Creando copia de seguridad comprimida en:${NC} ${FULL_PATH}"
    echo -e "${YELLOW}Por favor espera, comprimiendo tus documentos y configuraciones...${NC}\n"

    tar --exclude="${DEST_DIR}" \
        --exclude="${USER_HOME}/.cache" \
        --exclude="${USER_HOME}/.local/share/Trash" \
        -czf "$FULL_PATH" -C "$USER_HOME" . 2>/dev/null || true

    local SIZE
    SIZE=$(du -h "$FULL_PATH" 2>/dev/null | awk '{print $1}' || echo "N/A")
    msg_box "Respaldo Completado" "¡Tu copia de seguridad se creó exitosamente!\n\n• Archivo: ${FULL_PATH}\n• Tamaño: ${SIZE}"
}

sync_external_backup() {
    local DEST_DIR="/media"
    if [ -n "$UI" ]; then
        DEST_DIR=$($UI --title "Sincronización Incremental (rsync)" --inputbox \
"Ingresa la ruta de tu memoria USB o disco externo montado donde se sincronizarán tus archivos:" 11 72 "/mnt/usb_dzulux" 3>&1 1>&2 2>&3 || echo "")
    else
        read -p "Ruta de destino (ej. /mnt/usb_dzulux): " DEST_DIR
    fi
    [ -z "$DEST_DIR" ] && return
    sudo mkdir -p "${DEST_DIR}/Dzulux_Sync"

    clear
    echo -e "${CYAN}${BOLD}Sincronizando archivos hacia ${DEST_DIR}/Dzulux_Sync...${NC}"
    sudo rsync -avh --progress \
        --exclude=".cache" \
        --exclude=".local/share/Trash" \
        "${USER_HOME}/" "${DEST_DIR}/Dzulux_Sync/" || true

    msg_box "Sincronización Completada" "¡Todos tus archivos personales han sido sincronizados en:\n${DEST_DIR}/Dzulux_Sync!"
}

restore_tar_backup() {
    local FILE_PATH=""
    if [ -n "$UI" ]; then
        FILE_PATH=$($UI --title "Restaurar Respaldo" --inputbox \
"Ingresa la ruta completa del archivo .tar.gz que deseas restaurar:" 11 72 "${DEFAULT_BACKUP_DIR}/" 3>&1 1>&2 2>&3 || echo "")
    else
        read -p "Ruta del archivo .tar.gz a restaurar: " FILE_PATH
    fi
    [ -z "$FILE_PATH" ] && return

    if [ ! -f "$FILE_PATH" ]; then
        msg_box "Error" "No se encontró el archivo especificado:\n${FILE_PATH}"
        return
    fi

    clear
    echo -e "${YELLOW}${BOLD}Restaurando respaldo desde ${FILE_PATH} hacia ${USER_HOME}...${NC}"
    tar -xzf "$FILE_PATH" -C "$USER_HOME"
    msg_box "Restauración Exitosa" "¡Tus archivos y configuraciones han sido restaurados correctamente en ${USER_HOME}!"
}

list_backups() {
    local LIST
    LIST=$(ls -lh "$DEFAULT_BACKUP_DIR" 2>/dev/null || echo "No hay respaldos en la carpeta predeterminada.")
    msg_box "Respaldos en ${DEFAULT_BACKUP_DIR}" "${LIST}"
}

msg_box() {
    local TITLE="$1"
    local MSG="$2"
    if [ -n "$UI" ]; then
        $UI --title "${TITLE}" --msgbox "${MSG}" 14 72
    else
        echo -e "\n${GREEN}${BOLD}=== ${TITLE} ===${NC}\n${MSG}\n"
        read -p "Presiona ENTER para continuar..." _
    fi
}

main_menu