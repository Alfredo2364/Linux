#!/usr/bin/env bash
# ==============================================================================
# dzulux-cleaner - Herramienta de Mantenimiento y Limpieza Profunda
# Dzulux Linux 2.0 (Beta) - Diseñado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

TARGET_USER="${SUDO_USER:-$USER}"
TARGET_HOME="$HOME"
if [ -n "$TARGET_USER" ] && [ -d "/home/$TARGET_USER" ]; then
    TARGET_HOME="/home/$TARGET_USER"
fi

clear
echo -e "${CYAN}${BOLD}======================================================${NC}"
echo -e "${CYAN}${BOLD}        DZULUX SYSTEM CLEANER 2.0 (Alfredo Dzul)      ${NC}"
echo -e "${CYAN}${BOLD}======================================================${NC}"
echo "Iniciando limpieza profunda y segura del sistema..."
echo ""

# 1. Limpiar caché de paquetes APT
echo -e "${YELLOW}[1/5] Vaciando caché de instalaciones y actualizaciones (apt clean)...${NC}"
sudo apt-get clean || true
sudo apt-get autoclean -y || true

# 2. Eliminar dependencias huérfanas y Flatpaks sin uso
echo -e "${YELLOW}[2/5] Eliminando librerías huérfanas y paquetes sin uso (autoremove)...${NC}"
sudo apt-get autoremove --purge -y || true
if command -v flatpak >/dev/null 2>&1; then
    sudo flatpak uninstall --unused -y 2>/dev/null || true
fi

# 3. Limpiar registros antiguos del sistema (Systemd Journal)
echo -e "${YELLOW}[3/5] Borrando logs antiguos del sistema (dejando solo los últimos 3 días)...${NC}"
sudo journalctl --vacuum-time=3d || true

# 4. Limpiar miniaturas y caché del usuario
echo -e "${YELLOW}[4/5] Borrando caché de miniaturas de imágenes (${TARGET_HOME})...${NC}"
rm -rf "${TARGET_HOME}/.cache/thumbnails/"* 2>/dev/null || true

# 5. Vaciar la Papelera
echo -e "${YELLOW}[5/5] Vaciando la papelera de reciclaje...${NC}"
rm -rf "${TARGET_HOME}/.local/share/Trash/files/"* 2>/dev/null || true
rm -rf "${TARGET_HOME}/.local/share/Trash/info/"* 2>/dev/null || true

echo ""
echo -e "${GREEN}${BOLD}======================================================${NC}"
echo -e "${GREEN}${BOLD}       ✓ ¡Limpieza Completada con Éxito!              ${NC}"
echo -e "${GREEN}${BOLD}======================================================${NC}"
echo "Tu sistema Dzulux Linux 2.0 ahora está optimizado y con más espacio libre."
echo ""
if [ -t 0 ]; then
    read -r -p "Presiona ENTER para cerrar esta ventana..." _ || true
fi
