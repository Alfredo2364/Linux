#!/usr/bin/env bash
# ==============================================================================
# dzulux-live-init - Inicialización del Entorno Live de Dzulux Linux 2.0
# Diseñado y Creado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

# Asegurar grupo autologin
groupadd -r autologin 2>/dev/null || true

# Asegurar hostname dzulux en la sesión Live
echo "dzulux" > /etc/hostname 2>/dev/null || true
hostname dzulux 2>/dev/null || true

# Detectar o crear usuario live 'dzulux'
LIVE_USER="dzulux"
if ! id -u dzulux >/dev/null 2>&1; then
    useradd -m -u 1000 -c "Dzulux Live User" -s /bin/bash -G sudo,adm,cdrom,dip,plugdev,audio,video,netdev,autologin "${LIVE_USER}" 2>/dev/null || \
    useradd -m -u 1000 -s /bin/bash "${LIVE_USER}" 2>/dev/null || true
fi

usermod -aG sudo,adm,cdrom,dip,plugdev,audio,video,netdev,autologin,vboxsf "${LIVE_USER}" 2>/dev/null || true

# Desbloquear contraseñas para permitir entrar con Enter o con dzulux
passwd -d "${LIVE_USER}" 2>/dev/null || true
passwd -d root 2>/dev/null || true
echo "${LIVE_USER}:dzulux" | chpasswd 2>/dev/null || true
echo "root:dzulux" | chpasswd 2>/dev/null || true
passwd -d "${LIVE_USER}" 2>/dev/null || true
passwd -d root 2>/dev/null || true

# Asegurar propiedad completa de /home/$LIVE_USER
mkdir -p "/home/${LIVE_USER}/Desktop"
cp -rf /etc/skel/. "/home/${LIVE_USER}/" 2>/dev/null || true
chown -R "${LIVE_USER}:${LIVE_USER}" "/home/${LIVE_USER}" 2>/dev/null || true
chmod 755 "/home/${LIVE_USER}" 2>/dev/null || true

# Replicar temas y panel XFCE a nivel de sistema en tiempo de ejecución
if [ -d /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml ]; then
    mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml /etc/xdg/xfce4/panel
    cp -rf /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/* /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/ 2>/dev/null || true
    if [ -f /etc/skel/.config/xfce4/panel/whiskermenu-1.rc ]; then
        cp -f /etc/skel/.config/xfce4/panel/whiskermenu-1.rc /etc/xdg/xfce4/panel/ 2>/dev/null || true
    fi
fi

# Sudo 100% sin contraseña para el usuario live y root
mkdir -p /etc/sudoers.d
echo "${LIVE_USER} ALL=(ALL:ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${LIVE_USER}"
echo "root ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/root
chmod 440 /etc/sudoers.d/* 2>/dev/null || true

# Si se detectó hardware de laptop (batería), habilitar TLP
if [ -d /sys/class/power_supply ] && ls /sys/class/power_supply/BAT* 1>/dev/null 2>&1; then
    systemctl --no-block start tlp.service 2>/dev/null || true
fi

# Iniciar gestor de redes
systemctl --no-block start NetworkManager.service 2>/dev/null || true

# Iniciar Bluetooth si se detecta adaptador inalámbrico
if command -v rfkill >/dev/null 2>&1 && rfkill list bluetooth 2>/dev/null | grep -q "bluetooth"; then
    systemctl --no-block start bluetooth.service 2>/dev/null || true
fi

# Si se seleccionó Modo CLI en el arranque de GRUB, desactivar LightDM y aislar multi-user.target
if grep -q "system_mode=cli" /proc/cmdline; then
    systemctl mask lightdm.service display-manager.service 2>/dev/null || true
    systemctl --no-block stop lightdm.service display-manager.service 2>/dev/null || true
    systemctl set-default multi-user.target 2>/dev/null || true
fi
