#!/usr/bin/env bash
# ==============================================================================
# dzulux-update - Actualizador del Sistema y Suite Dzulux Linux 2.0
# Diseñado y Creado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

REPO_OWNER="Alfredo2364"
REPO_NAME="Linux"
REPO_BRANCH="main"
RAW_BASE="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${REPO_BRANCH}"
API_URL="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest"

banner() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "=================================================================="
    echo "         ACTUALIZADOR OFICIAL DE DZULUX LINUX 2.0 (BETA)"
    echo "             Diseñado y Creado por Alfredo Dzul"
    echo "=================================================================="
    echo -e "${NC}"
}

verificar_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${YELLOW}Se requieren permisos de superusuario para actualizar componentes del sistema.${NC}"
        exec sudo "$0" "$@"
    fi
}

verificar_internet() {
    echo -n "Comprobando conexión a los servidores de Dzulux..."
    if curl -s --head --request GET "https://raw.githubusercontent.com" | grep "200\|301\|302" >/dev/null 2>&1; then
        echo -e " [ ${GREEN}CONECTADO${NC} ]"
    else
        echo -e " [ ${RED}SIN INTERNET${NC} ]"
        echo -e "${RED}Error: Necesitas conexión a internet para descargar actualizaciones.${NC}"
        echo "Conéctate a una red Wi-Fi mediante el comando 'nmtui' o la bandeja de red."
        exit 1
    fi
}

crear_snapshot_seguridad() {
    if mount | grep -q "on / type btrfs"; then
        echo -e "${CYAN}==> Creando punto de restauración de seguridad (Snapshot Btrfs)...${NC}"
        mkdir -p /.snapshots
        SNAPSHOT_NAME="/.snapshots/snapshot_pre_update_$(date +%Y%m%d_%H%M%S)"
        btrfs subvolume snapshot / "$SNAPSHOT_NAME" >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Snapshot de seguridad creado con éxito.${NC}"
    fi
}

do_update_suite() {
    echo -e "${YELLOW}==> Sincronizando scripts oficiales de Dzulux 2.0 desde GitHub (${REPO_BRANCH})...${NC}\n"

    # dzulux-update va al final para evitar problemas de offset de lectura en bash al auto-actualizarse
    SCRIPTS=(
        "dzulux-installer"
        "dzulux-drivers"
        "dzulux-apps"
        "dzulux-gaming"
        "dzulux-cleaner"
        "dzulux-backup"
        "dzulux-share"
        "dzulux-usb"
        "dzulux-snapshots"
        "dzulux-rescue"
        "dzulux-battery"
        "dzulux-stealth"
        "dzulux-looks"
        "dzulux-performance"
        "switch-mode"
        "hw-detect"
        "dzulux-welcome"
        "dzulux-live-init"
        "dzulux-update"
    )

    for script in "${SCRIPTS[@]}"; do
        URL="${RAW_BASE}/dzulux-tools/${script}"
        DEST="/usr/local/bin/${script}"
        echo -n "Descargando ${script}..."
        if curl -s -f -L "$URL" -o "${DEST}.tmp"; then
            mv "${DEST}.tmp" "$DEST"
            chmod 755 "$DEST"
            echo -e " [ ${GREEN}ACTUALIZADO${NC} ]"
        else
            rm -f "${DEST}.tmp"
            echo -e " [ ${YELLOW}OMITIDO/LOCAL${NC} ]"
        fi
    done
}

actualizar_suite() {
    banner
    verificar_root
    verificar_internet
    crear_snapshot_seguridad
    do_update_suite

    echo ""
    echo -e "${GREEN}${BOLD}¡La Suite Dzulux Linux 2.0 se ha actualizado exitosamente a la última versión!${NC}"
    echo "Todas las nuevas herramientas, mejoras y parches ya están instalados y listos para usar."
    read -p "Presiona ENTER para volver al menú..." _
}

do_update_ubuntu_security() {
    echo -e "${CYAN}==> Verificando canales oficiales de seguridad de Ubuntu 24.04 LTS (noble-security / noble-updates)...${NC}"
    if ! grep -q "noble-security" /etc/apt/sources.list 2>/dev/null; then
        cat <<'EOF' > /etc/apt/sources.list
deb http://archive.ubuntu.com/ubuntu/ noble main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu/ noble-updates main restricted universe multiverse
deb http://security.ubuntu.com/ubuntu/ noble-security main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu/ noble-backports main restricted universe multiverse
EOF
    fi

    echo -e "${YELLOW}==> Descargando e instalando parches de seguridad críticos y de Kernel (CVE)...${NC}"
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
    DEBIAN_FRONTEND=noninteractive apt-get install -y unattended-upgrades apt-listchanges 2>/dev/null || true

    mkdir -p /etc/apt/apt.conf.d
    cat <<'EOF' > /etc/apt/apt.conf.d/20auto-upgrades
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APT::Periodic::Unattended-Upgrade "1";
EOF
    systemctl enable --now unattended-upgrades.service 2>/dev/null || true

    # Preservar identidad Dzulux Linux 2.0 por si el paquete base-files de Ubuntu se actualizó
    if grep -q "Ubuntu" /usr/lib/os-release 2>/dev/null; then
        sed -i 's/PRETTY_NAME=.*/PRETTY_NAME="Dzulux Linux 2.0 (Beta)"/' /usr/lib/os-release
        sed -i 's/^NAME=.*/NAME="Dzulux Linux"/' /usr/lib/os-release
        sed -i 's/^ID=.*/ID=dzulux/' /usr/lib/os-release
    fi
}

actualizar_seguridad_ubuntu() {
    banner
    verificar_root
    verificar_internet
    crear_snapshot_seguridad
    do_update_ubuntu_security

    echo ""
    echo -e "${GREEN}${BOLD}✓ ¡Parches de seguridad de Ubuntu LTS aplicados y protección automática (unattended-upgrades) activa!${NC}"
    read -p "Presiona ENTER para continuar..." _
}

actualizar_sistema_completo() {
    banner
    verificar_root
    verificar_internet
    crear_snapshot_seguridad

    echo -e "\n${YELLOW}==> [Paso 1/2] Actualizando la Suite Dzulux 2.0 desde GitHub...${NC}"
    do_update_suite

    echo -e "\n${YELLOW}==> [Paso 2/2] Sincronizando parches de seguridad y paquetes de Ubuntu LTS...${NC}"
    do_update_ubuntu_security
    apt-get autoremove -y >/dev/null 2>&1 || true

    echo ""
    echo -e "${GREEN}${BOLD}==================================================================${NC}"
    echo -e "${GREEN}${BOLD}    ¡Actualización completa del sistema finalizada con éxito!     ${NC}"
    echo -e "${GREEN}${BOLD}==================================================================${NC}"
    echo "Tu sistema cuenta con las últimas herramientas de Dzulux y los parches de seguridad de Ubuntu al día."
    read -p "Presiona ENTER para continuar..." _
}

comprobar_version_iso() {
    banner
    verificar_internet

    echo -e "${CYAN}Consultando últimas publicaciones en GitHub Releases...${NC}\n"

    LOCAL_VER=$(grep "^VERSION=" /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "2.0 (Beta)")
    LATEST_JSON=$(curl -s "$API_URL" || true)

    if [ -z "$LATEST_JSON" ] || ! echo "$LATEST_JSON" | grep -q "tag_name"; then
        echo -e "${YELLOW}No se pudo obtener información automática de Releases (usando canal 'latest').${NC}"
        LATEST_TAG="latest"
        LATEST_NAME="Dzulux Linux 2.0 (Auto-Build)"
    else
        LATEST_TAG=$(echo "$LATEST_JSON" | grep -m1 '"tag_name":' | cut -d':' -f2 | tr -d '", ')
        LATEST_NAME=$(echo "$LATEST_JSON" | grep -m1 '"name":' | cut -d':' -f2- | sed 's/^[ "]*//;s/[ ",]*$//')
    fi

    echo -e "Versión instalada actualmente: ${BOLD}${LOCAL_VER}${NC}"
    echo -e "Última versión en GitHub:      ${GREEN}${BOLD}${LATEST_TAG} (${LATEST_NAME})${NC}\n"

    DESKTOP_ISO_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${LATEST_TAG}/dzulux-desktop-hybrid.iso"
    SERVER_ISO_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${LATEST_TAG}/dzulux-server-hybrid.iso"

    echo "Opciones disponibles:"
    echo "1) Descargar imagen ISO de Dzulux Desktop (GUI) a tu carpeta Descargas"
    echo "2) Descargar imagen ISO de Dzulux Server (CLI) a tu carpeta Descargas"
    echo "3) Volver al menú principal"
    echo ""
    read -p "Selecciona una opción [1-3]: " opt_iso

    TARGET_USER="${SUDO_USER:-$USER}"
    TARGET_HOME="$HOME"
    if [ -n "$TARGET_USER" ] && [ -d "/home/$TARGET_USER" ]; then
        TARGET_HOME="/home/$TARGET_USER"
    fi
    TARGET_DIR="$TARGET_HOME/Descargas"
    [ -d "$TARGET_DIR" ] || TARGET_DIR="$TARGET_HOME/Downloads"
    mkdir -p "$TARGET_DIR"
    chown "$TARGET_USER:$TARGET_USER" "$TARGET_DIR" 2>/dev/null || true

    case "$opt_iso" in
        1)
            echo -e "${YELLOW}Descargando Dzulux Desktop ISO en ${TARGET_DIR}...${NC}"
            wget -c "$DESKTOP_ISO_URL" -P "$TARGET_DIR"
            chown "$TARGET_USER:$TARGET_USER" "$TARGET_DIR/"*.iso 2>/dev/null || true
            echo -e "${GREEN}✓ Descarga completada en: ${TARGET_DIR}${NC}"
            ;;
        2)
            echo -e "${YELLOW}Descargando Dzulux Server ISO en ${TARGET_DIR}...${NC}"
            wget -c "$SERVER_ISO_URL" -P "$TARGET_DIR"
            chown "$TARGET_USER:$TARGET_USER" "$TARGET_DIR/"*.iso 2>/dev/null || true
            echo -e "${GREEN}✓ Descarga completada en: ${TARGET_DIR}${NC}"
            ;;
        *)
            return
            ;;
    esac
    read -p "Presiona ENTER para continuar..." _
}

menu_principal() {
    while true; do
        banner
        echo "Elige qué deseas actualizar:"
        echo ""
        echo -e "  ${GREEN}1)${NC} ⚡ ${BOLD}Actualizar Suite Dzulux${NC} (Descarga los últimos scripts y herramientas desde GitHub)"
        echo -e "  ${GREEN}2)${NC} 🛡️ ${BOLD}Instalar Parches de Seguridad de Ubuntu LTS${NC} (CVE + Kernel + Auto-Actualizaciones)"
        echo -e "  ${GREEN}3)${NC} 📦 ${BOLD}Actualizar Sistema Completo${NC} (Suite Dzulux + Seguridad + Todos los paquetes APT)"
        echo -e "  ${GREEN}4)${NC} 💿 ${BOLD}Comprobar / Descargar Nueva Versión de la ISO${NC}"
        echo -e "  ${GREEN}5)${NC} 📸 ${BOLD}Crear Punto de Restauración de Emergencia (Snapshot)${NC}"
        echo -e "  ${RED}6)${NC} 🚪 Salir"
        echo ""
        read -p "Ingresa tu opción [1-6]: " opc

        case "$opc" in
            1) actualizar_suite ;;
            2) actualizar_seguridad_ubuntu ;;
            3) actualizar_sistema_completo ;;
            4) comprobar_version_iso ;;
            5) 
                verificar_root
                crear_snapshot_seguridad
                read -p "Presiona ENTER para continuar..." _
                ;;
            6) 
                echo "¡Hasta pronto!"
                exit 0 
                ;;
            *) 
                echo -e "${RED}Opción no válida.${NC}"
                sleep 1
                ;;
        esac
    done
}

if [ "${1:-}" == "--quick" ] || [ "${1:-}" == "-q" ] || [ "${1:-}" == "--auto" ]; then
    actualizar_suite
    exit 0
fi

menu_principal
