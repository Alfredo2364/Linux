#!/usr/bin/env bash
# ==============================================================================
# dzulux-rescue - Herramienta de Rescate de Windows y Diagnóstico de Disco
# Dzulux Linux - Diseñado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

if command -v dialog >/dev/null 2>&1; then
    UI="dialog"
elif command -v whiptail >/dev/null 2>&1; then
    UI="whiptail"
else
    UI=""
fi

main_menu() {
    if [ -n "$UI" ]; then
        CHOICE=$($UI --title "Dzulux Rescue - Rescate y Diagnóstico (Alfredo Dzul)" --menu \
"Selecciona una herramienta de rescate:" 16 70 4 \
"1" "🔑 Quitar Contraseña Olvidada de Windows (SAM Reset)" \
"2" "📂 Rescatar Archivos de Partición Windows Dañada" \
"3" "🩺 Auditoría de Salud del Disco Duro (S.M.A.R.T.)" \
"4" "Salir" 3>&1 1>&2 2>&3)
    else
        clear
        echo -e "${CYAN}${BOLD}=== DZULUX RESCUE - HERRAMIENTAS DE EMERGENCIA ===${NC}"
        echo -e "Diseñado por Alfredo Dzul\n"
        echo "1) Quitar Contraseña de Windows Olvidada"
        echo "2) Rescatar Archivos de Partición Windows"
        echo "3) Auditoría de Salud de Disco (S.M.A.R.T.)"
        echo "4) Salir"
        read -p "Elige una opción (1-4): " CHOICE
    fi

    case "$CHOICE" in
        1) reset_windows_password ;;
        2) rescue_windows_files ;;
        3) check_disk_health ;;
        *) exit 0 ;;
    esac
}

reset_windows_password() {
    clear
    echo -e "${CYAN}${BOLD}Buscando instalaciones de Windows en tus discos...${NC}"
    
    WIN_PARTS="$(lsblk -lno NAME,FSTYPE | grep -iE "ntfs|vfat" | awk '{print "/dev/"$1}' || true)"
    if [ -z "$WIN_PARTS" ]; then
        echo -e "${RED}No se encontraron particiones NTFS de Windows.${NC}"
        read -p "Presiona ENTER para volver..." _
        main_menu
        return
    fi

    TARGET_SAM=""
    for p in $WIN_PARTS; do
        sudo mkdir -p /tmp/win_mnt
        if sudo mount -o ro "$p" /tmp/win_mnt 2>/dev/null; then
            if [ -f "/tmp/win_mnt/Windows/System32/config/SAM" ]; then
                TARGET_SAM="/tmp/win_mnt/Windows/System32/config/SAM"
                WIN_PART_FOUND="$p"
                sudo umount /tmp/win_mnt
                sudo mount -o rw "$p" /tmp/win_mnt
                break
            fi
            sudo umount /tmp/win_mnt 2>/dev/null || true
        fi
    done

    if [ -n "$TARGET_SAM" ]; then
        echo -e "${GREEN}¡Partición de Windows encontrada en ${WIN_PART_FOUND}!${NC}"
        echo -e "Ejecutando chntpw para restablecer contraseña...\n"
        cd /tmp/win_mnt/Windows/System32/config/
        sudo chntpw -u Administrator SAM 2>/dev/null || sudo chntpw -i SAM
        cd /
        sudo umount /tmp/win_mnt
        echo -e "\n${GREEN}${BOLD}✓ ¡Contraseña de Windows actualizada / eliminada con éxito!${NC}"
    else
        echo -e "${YELLOW}No se pudo localizar el archivo SAM de Windows.${NC}"
    fi

    read -p "Presiona ENTER para volver..." _
    main_menu
}

rescue_windows_files() {
    clear
    echo -e "${CYAN}${BOLD}Montando particiones de Windows en modo de solo lectura seguro...${NC}"
    WIN_PARTS="$(lsblk -lno NAME,FSTYPE | grep -i "ntfs" | awk '{print "/dev/"$1}' || true)"
    
    if [ -z "$WIN_PARTS" ]; then
        echo -e "${RED}No se encontraron particiones NTFS.${NC}"
        read -p "Presiona ENTER para volver..." _
        main_menu
        return
    fi

    sudo mkdir -p /mnt/windows_rescue
    for p in $WIN_PARTS; do
        if sudo mount -o ro "$p" /mnt/windows_rescue 2>/dev/null; then
            echo -e "${GREEN}✓ Partición $p montada en /mnt/windows_rescue${NC}"
            if command -v thunar >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
                thunar /mnt/windows_rescue &
            fi
            echo "Puedes copiar tus fotos y tareas desde /mnt/windows_rescue hacia otra memoria USB."
            break
        fi
    done

    read -p "Presiona ENTER para volver..." _
    main_menu
}

check_disk_health() {
    clear
    echo -e "${CYAN}${BOLD}Diagnóstico de Salud de Discos (S.M.A.R.T.):${NC}\n"
    DISKS="$(lsblk -dno NAME,TYPE | grep -i "disk" | awk '{print "/dev/"$1}')"
    
    for d in $DISKS; do
        echo -e "${YELLOW}Auditoría para ${d}:${NC}"
        if command -v smartctl >/dev/null 2>&1; then
            sudo smartctl -H "$d" 2>/dev/null | grep -E "result|status|passed|failed" || true
            sudo smartctl -A "$d" 2>/dev/null | grep -iE "reallocated|temperature|power_on" || true
        else
            echo "smartctl no disponible en esta sesión."
        fi
        echo "-----------------------------------------------------"
    done

    read -p "Presiona ENTER para volver..." _
    main_menu
}

main_menu
