#!/usr/bin/env bash
# ==============================================================================
# dzulux-update - Actualizador del Sistema y Suite Dzulux Linux
# Diseñado y Creado por Alfredo Dzul
# ==============================================================================

set -euo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

REPO_OWNER="Alfredo2364"
REPO_NAME="Linux"
REPO_BRANCH="main"
RAW_BASE="https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${REPO_BRANCH}"
API_URL="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest"

banner() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "=================================================================="
    echo "         ACTUALIZADOR OFICIAL DE DZULUX LINUX"
    echo "             Diseñado y Creado por Alfredo Dzul"
    echo "=================================================================="
    echo -e "${NC}"
}

verificar_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${YELLOW}Se requieren permisos de superusuario para actualizar componentes del sistema.${NC}"
        exec sudo "$0" "$@"
    fi
}

verificar_internet() {
    echo -n "Comprobando conexión a los servidores de Dzulux..."
    if curl -s --head --request GET "https://raw.githubusercontent.com" | grep "200\|301\|302" >/dev/null 2>&1; then
        echo -e " [ ${GREEN}CONECTADO${NC} ]"
    else
        echo -e " [ ${RED}SIN INTERNET${NC} ]"
        echo -e "${RED}Error: Necesitas conexión a internet para descargar actualizaciones.${NC}"
        echo "Conéctate a una red Wi-Fi mediante el comando 'nmtui' o la bandeja de red."
        exit 1
    fi
}

crear_snapshot_seguridad() {
    if mount | grep -q "on / type btrfs"; then
        echo -e "${CYAN}==> Creando punto de restauración de seguridad (Snapshot Btrfs)...${NC}"
        mkdir -p /.snapshots
        SNAPSHOT_NAME="/.snapshots/snapshot_pre_update_$(date +%Y%m%d_%H%M%S)"
        btrfs subvolume snapshot / "$SNAPSHOT_NAME" >/dev/null 2>&1 || true
        echo -e "${GREEN}✓ Snapshot de seguridad creado con éxito.${NC}"
    fi
}

actualizar_suite() {
    banner
    verificar_root
    verificar_internet
    crear_snapshot_seguridad

    echo -e "${YELLOW}==> Sincronizando scripts oficiales de Dzulux desde GitHub (${REPO_BRANCH})...${NC}"
    echo ""

    SCRIPTS=(
        "dzulux-installer"
        "dzulux-drivers"
        "dzulux-apps"
        "dzulux-snapshots"
        "dzulux-rescue"
        "dzulux-battery"
        "dzulux-stealth"
        "dzulux-looks"
        "dzulux-performance"
        "dzulux-update"
        "switch-mode"
        "hw-detect"
        "dzulux-welcome"
        "dzulux-live-init"
    )

    for script in "${SCRIPTS[@]}"; do
        URL="${RAW_BASE}/iso-profile/airootfs/usr/local/bin/${script}"
        DEST="/usr/local/bin/${script}"
        echo -n "Descargando ${script}..."
        if curl -s -f -L "$URL" -o "${DEST}.tmp"; then
            mv "${DEST}.tmp" "$DEST"
            chmod 755 "$DEST"
            echo -e " [ ${GREEN}ACTUALIZADO${NC} ]"
        else
            rm -f "${DEST}.tmp"
            echo -e " [ ${YELLOW}OMITIDO/LOCAL${NC} ]"
        fi
    done

    echo ""
    echo -e "${YELLOW}==> Sincronizando lanzadores de escritorio en el menú de aplicaciones...${NC}"
    DESKTOPS=(
        "dzulux-apps.desktop"
        "dzulux-battery.desktop"
        "dzulux-drivers.desktop"
        "dzulux-looks.desktop"
        "dzulux-performance.desktop"
        "dzulux-rescue.desktop"
        "dzulux-snapshots.desktop"
        "dzulux-stealth.desktop"
        "dzulux-update.desktop"
    )

    mkdir -p /usr/share/applications
    for app in "${DESKTOPS[@]}"; do
        URL="${RAW_BASE}/iso-profile/airootfs/usr/share/applications/${app}"
        DEST="/usr/share/applications/${app}"
        echo -n "Descargando lanzador ${app}..."
        if curl -s -f -L "$URL" -o "${DEST}.tmp"; then
            mv "${DEST}.tmp" "$DEST"
            chmod 644 "$DEST"
            echo -e " [ ${GREEN}ACTUALIZADO${NC} ]"
        else
            rm -f "${DEST}.tmp"
            echo -e " [ ${YELLOW}OMITIDO${NC} ]"
        fi
    done

    # Actualizar identidad y os-release
    echo ""
    echo -e "${YELLOW}==> Sincronizando datos de identidad y versión...${NC}"
    curl -s -f -L "${RAW_BASE}/iso-profile/airootfs/etc/os-release" -o /etc/os-release.tmp && mv /etc/os-release.tmp /etc/os-release || true
    curl -s -f -L "${RAW_BASE}/iso-profile/airootfs/etc/issue" -o /etc/issue.tmp && mv /etc/issue.tmp /etc/issue || true
    curl -s -f -L "${RAW_BASE}/iso-profile/airootfs/etc/motd" -o /etc/motd.tmp && mv /etc/motd.tmp /etc/motd || true

    echo ""
    echo -e "${GREEN}${BOLD}¡La Suite Dzulux Linux se ha actualizado exitosamente a la última versión!${NC}"
    echo "Todas las nuevas herramientas, mejoras y parches ya están instalados y listos para usar."
    read -p "Presiona ENTER para volver al menú..."
}

actualizar_sistema_completo() {
    banner
    verificar_root
    verificar_internet
    crear_snapshot_seguridad

    echo -e "${YELLOW}==> 1. Actualizando la Suite Dzulux desde GitHub...${NC}"
    actualizar_suite

    echo ""
    echo -e "${YELLOW}==> 2. Sincronizando repositorios y paquetes oficiales de Arch Linux...${NC}"
    pacman -Syu --noconfirm

    echo ""
    echo -e "${GREEN}${BOLD}¡Actualización completa del sistema finalizada con éxito!${NC}"
    read -p "Presiona ENTER para continuar..."
}

comprobar_version_iso() {
    banner
    verificar_internet

    echo -e "${CYAN}Consultando últimas publicaciones en GitHub Releases...${NC}"
    echo ""

    LOCAL_VER=$(grep "^VERSION=" /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "1.1 (Beta)")
    LATEST_JSON=$(curl -s "$API_URL" || true)

    if [ -z "$LATEST_JSON" ] || ! echo "$LATEST_JSON" | grep -q "tag_name"; then
        echo -e "${YELLOW}No se pudo obtener información de Releases (posible límite de API).${NC}"
        echo "Puedes revisar las versiones manualmente en: https://github.com/${REPO_OWNER}/${REPO_NAME}/releases"
        read -p "Presiona ENTER para continuar..."
        return
    fi

    LATEST_TAG=$(echo "$LATEST_JSON" | grep -m1 '"tag_name":' | cut -d':' -f2 | tr -d '", ')
    LATEST_NAME=$(echo "$LATEST_JSON" | grep -m1 '"name":' | cut -d':' -f2- | sed 's/^[ "]*//;s/[ ",]*$//')

    echo -e "Versión instalada actualmente: ${BOLD}${LOCAL_VER}${NC}"
    echo -e "Última versión en GitHub:      ${GREEN}${BOLD}${LATEST_TAG} (${LATEST_NAME})${NC}"
    echo ""

    ZIP_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${LATEST_TAG}/Dzulux-Linux-1.1-Beta-Paquete-Completo.zip"
    ISO_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${LATEST_TAG}/dzulux-1.1-beta-x86_64.iso"

    echo "Opciones disponibles:"
    echo "1) Descargar la imagen .ISO más reciente a tu carpeta Descargas"
    echo "2) Descargar el Paquete Completo ZIP (ISO + Guía PDF)"
    echo "3) Volver al menú principal"
    echo ""
    read -p "Selecciona una opción [1-3]: " opt_iso

    TARGET_DIR="$HOME/Descargas"
    [ -d "$TARGET_DIR" ] || TARGET_DIR="$HOME/Downloads"
    mkdir -p "$TARGET_DIR"

    case "$opt_iso" in
        1)
            echo -e "${YELLOW}Descargando imagen ISO en ${TARGET_DIR}...${NC}"
            wget -c "$ISO_URL" -P "$TARGET_DIR"
            echo -e "${GREEN}✓ Descarga completada en: ${TARGET_DIR}${NC}"
            ;;
        2)
            echo -e "${YELLOW}Descargando Paquete Completo ZIP en ${TARGET_DIR}...${NC}"
            wget -c "$ZIP_URL" -P "$TARGET_DIR"
            echo -e "${GREEN}✓ Descarga completada en: ${TARGET_DIR}${NC}"
            ;;
        *)
            return
            ;;
    esac
    read -p "Presiona ENTER para continuar..."
}

menu_principal() {
    while true; do
        banner
        echo "Elige qué deseas actualizar:"
        echo ""
        echo -e "  ${GREEN}1)${NC} ⚡ ${BOLD}Actualizar Suite Dzulux${NC} (Descarga los últimos scripts, parches y herramientas de GitHub)"
        echo -e "  ${GREEN}2)${NC} 📦 ${BOLD}Actualizar Sistema Completo${NC} (Suite Dzulux + Paquetes base de Arch Linux)"
        echo -e "  ${GREEN}3)${NC} 💿 ${BOLD}Comprobar Nueva Versión de la ISO / Releases${NC}"
        echo -e "  ${GREEN}4)${NC} 🛡️ ${BOLD}Crear Punto de Restauración de Emergencia (Snapshot)${NC}"
        echo -e "  ${RED}5)${NC} 🚪 Salir"
        echo ""
        read -p "Ingresa tu opción [1-5]: " opc

        case "$opc" in
            1) actualizar_suite ;;
            2) actualizar_sistema_completo ;;
            3) comprobar_version_iso ;;
            4) 
                verificar_root
                crear_snapshot_seguridad
                read -p "Presiona ENTER para continuar..."
                ;;
            5) 
                echo "¡Hasta pronto!"
                exit 0 
                ;;
            *) 
                echo -e "${RED}Opción no válida.${NC}"
                sleep 1
                ;;
        esac
    done
}

# Si se pasa el argumento --auto o --quick, actualiza directamente la suite
if [ "${1:-}" == "--quick" ] || [ "${1:-}" == "-q" ] || [ "${1:-}" == "--auto" ]; then
    actualizar_suite
    exit 0
fi

menu_principal
