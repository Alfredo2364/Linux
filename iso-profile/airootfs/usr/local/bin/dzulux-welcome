#!/usr/bin/env bash
# ==============================================================================
# dzulux-welcome - Pantalla de Bienvenida de Dzulux Linux (Beta)
# Diseñado y Creado por Alfredo Dzul
# ==============================================================================

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

clear
if command -v fastfetch >/dev/null 2>&1; then
    fastfetch --logo none
else
    cat /etc/motd
fi

echo -e "${CYAN}${BOLD}"
echo "================================================================="
echo "      ¡Bienvenido al Entorno Live de Dzulux Linux 1.1 (Beta)!    "
echo "                   Diseñado por Alfredo Dzul                    "
echo "================================================================="
echo -e "${NC}"
echo -e "Herramientas de la Suite Dzulux (Diseñadas por Alfredo Dzul):"
echo -e "  • ${GREEN}${BOLD}dzulux-installer${NC}  -> Instalar Dzulux en tu disco (Dual Boot o Limpio)"
echo -e "  • ${GREEN}${BOLD}dzulux-drivers${NC}    -> Descarga inteligente de controladores (GPU, Wi-Fi, Audio)"
echo -e "  • ${GREEN}${BOLD}dzulux-apps${NC}       -> Instalar Steam, Discord, VS Code, Office en 1 clic"
echo -e "  • ${GREEN}${BOLD}dzulux-snapshots${NC}  -> Puntos de restauración instantáneos con Btrfs"
echo -e "  • ${GREEN}${BOLD}dzulux-rescue${NC}     -> Quitar contraseñas de Windows y recuperar archivos"
echo -e "  • ${GREEN}${BOLD}dzulux-battery${NC}    -> Ahorro inteligente de batería con Wi-Fi configurable"
echo -e "  • ${GREEN}${BOLD}dzulux-stealth${NC}    -> Escudo de privacidad para Wi-Fi públicos (MAC aleatoria)"
echo -e "  • ${GREEN}${BOLD}dzulux-looks${NC}      -> Alternar entre tema Cyberpunk y estilo Windows"
echo -e "  • ${GREEN}${BOLD}dzulux-performance${NC}-> Perfiles de CPU: Oficina, Game Booster y Streaming Sin Límites"
echo -e "  • ${GREEN}${BOLD}dzulux-update${NC}     -> Actualizador OTA del sistema y herramientas desde GitHub"
echo -e "  • ${GREEN}${BOLD}hw-detect${NC}         -> Diagnóstico y auditoría completa de hardware"
echo -e "  • ${GREEN}${BOLD}switch-mode${NC}       -> Alternar entre Modo Gráfico (gui) y Terminal (cli)"
echo -e "  • ${GREEN}${BOLD}nmtui${NC}             -> Conectar a Wi-Fi en terminal"
echo ""
echo -e "Servicios de Servidor disponibles (Estilo Ubuntu Server):"
echo -e "  * SSH Server: 'sudo systemctl start sshd' (o 'enable sshd' para inicio automático)"
echo -e "  * Firewall UFW: 'sudo ufw enable' y 'sudo ufw allow 22/tcp'"
echo ""
echo -e "${YELLOW}Nota: Sistema en fase BETA 1.1. Reporta detalles en: https://github.com/Alfredo2364/Linux${NC}"
echo "================================================================="
